<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde cloud et transfert d'appareil, sans la clé Météo-France. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
