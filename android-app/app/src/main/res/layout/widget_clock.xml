<?xml version="1.0" encoding="utf-8"?>
<!-- Date + time always up to date (TextClock), inserted in the Glance widgets through AndroidRemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="@string/clock_date_pattern"
        android:format24Hour="@string/clock_date_pattern"
        android:fontFamily="sans-serif-medium"
        android:textSize="12sp" />

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textSize="30sp" />
</LinearLayout>
